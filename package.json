{
  "name": "komunitas-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord Bot Community All-in-One untuk server komunitas publik Indonesia — identitas digital (KTP), leveling, ekonomi, tiket, moderasi, keamanan, dan AI, 100% dikontrol dari Discord.",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/index.js",
    "deploy-commands": "tsx src/handlers/deployCommands.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "bottleneck": "^2.19.5",
    "bwip-js": "^4.11.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "i18next": "^23.16.5",
    "i18next-fs-backend": "^2.3.2",
    "ioredis": "^5.4.1",
    "mongoose": "^8.8.3",
    "nanoid": "^5.0.7",
    "node-cron": "^3.0.3",
    "openai": "^4.71.1",
    "pdfkit": "^0.15.1",
    "qrcode": "^1.5.4",
    "winston": "^3.15.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.4",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
