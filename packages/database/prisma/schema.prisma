// NexusBot — Prisma schema
// Enterprise-grade Discord bot platform data model.
// Domains: Identity/Auth, Guilds, Moderation, Economy, Leveling, Tickets,
// Engagement, Identity Cards (RP), Premium/Billing, Analytics, Platform/Admin.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// IDENTITY & AUTH
// ─────────────────────────────────────────────────────────────────────────

enum PlatformRole {
  USER
  MODERATOR
  ADMIN
  OWNER
}

model User {
  id                String    @id @default(cuid())
  email             String?   @unique
  emailVerified     DateTime?
  passwordHash      String?
  discordId         String?   @unique
  username          String
  displayName       String?
  avatarUrl         String?
  role              PlatformRole @default(USER)

  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  twoFactorBackupCodes String[] @default([])

  isBlacklisted     Boolean   @default(false)
  blacklistReason   String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  accounts          Account[]
  sessions          Session[]
  apiKeys           ApiKey[]
  guildMemberships  GuildStaff[]
  auditLogs         AuditLog[]
  subscription      Subscription?
  identityCards     IdentityCard[]
  ticketsAssigned   Ticket[]        @relation("TicketAssignee")
  ticketMessages    TicketMessage[]
  referralsGiven    Referral[]      @relation("ReferralInviter")
  referralsReceived Referral[]      @relation("ReferralInvitee")
  invoices          Invoice[]
  webhooks          Webhook[]
  affiliateCode     String?         @unique

  @@map("users")
  @@index([discordId])
}

enum AccountProvider {
  DISCORD
  GOOGLE
  EMAIL
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AccountProvider
  providerAccountId String
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  expiresAt         DateTime?
  scope             String?

  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  @@map("sessions")
  @@index([userId])
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  keyHash     String    @unique
  keyPrefix   String
  scopes      String[]  @default([])
  rateLimit   Int       @default(60)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("api_keys")
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// GUILDS
// ─────────────────────────────────────────────────────────────────────────

model Guild {
  id            String   @id // Discord snowflake
  name          String
  iconUrl       String?
  ownerId       String
  memberCount   Int      @default(0)
  region        String?
  premiumTier   PremiumTier @default(FREE)
  isBlacklisted Boolean  @default(false)
  installedAt   DateTime @default(now())
  leftAt        DateTime?

  settings          GuildSettings?
  staff             GuildStaff[]
  members           GuildMember[]
  moderationCases   ModerationCase[]
  autoModRules      AutoModRule[]
  reactionRoles     ReactionRole[]
  tickets           Ticket[]
  giveaways         Giveaway[]
  reminders         Reminder[]
  birthdays         Birthday[]
  economyItems      Item[]
  levelRewards      LevelRoleReward[]
  auditLogs         AuditLog[]
  webhooks          Webhook[]
  invites           InviteRecord[]
  boostEvents       BoostEvent[]
  statSnapshots     GuildStatSnapshot[]
  aiChatLogs        AiChatLog[]
  identityCards     IdentityCard[]
  plugins           GuildPlugin[]
  backups           Backup[]

  @@map("guilds")
}

model GuildSettings {
  guildId            String  @id
  guild              Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  prefix             String  @default("!")
  locale             String  @default("en")
  timezone           String  @default("UTC")

  moderationLogChannelId String?
  welcomeChannelId       String?
  welcomeMessage         String? @db.Text
  goodbyeChannelId       String?
  goodbyeMessage         String? @db.Text
  autoRoleIds            String[] @default([])

  antiSpam          Boolean @default(true)
  antiRaid          Boolean @default(true)
  antiMention        Boolean @default(true)
  antiLink           Boolean @default(false)
  antiInvite         Boolean @default(true)
  antiScam           Boolean @default(true)
  antiPhishing        Boolean @default(true)
  antiTokenGrabber    Boolean @default(true)
  captchaVerification Boolean @default(false)

  levelingEnabled   Boolean @default(true)
  economyEnabled    Boolean @default(true)
  ticketsEnabled    Boolean @default(true)
  musicEnabled      Boolean @default(true)
  aiAssistantEnabled Boolean @default(false)

  updatedAt         DateTime @updatedAt

  @@map("guild_settings")
}

enum StaffRole {
  MODERATOR
  ADMIN
  OWNER
}

model GuildStaff {
  id      String    @id @default(cuid())
  guildId String
  guild   Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    StaffRole @default(MODERATOR)
  addedAt DateTime  @default(now())

  @@unique([guildId, userId])
  @@map("guild_staff")
}

model GuildMember {
  id            String   @id @default(cuid())
  guildId       String
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordUserId String
  username      String
  avatarUrl     String?
  joinedAt      DateTime @default(now())
  leftAt        DateTime?
  isBot         Boolean  @default(false)
  roles         String[] @default([])

  xp              Int      @default(0)
  level           Int      @default(0)
  messageCount    Int      @default(0)
  voiceMinutes    Int      @default(0)

  economy         EconomyProfile?
  warnings        ModerationCase[] @relation("MemberWarnings")

  @@unique([guildId, discordUserId])
  @@map("guild_members")
  @@index([guildId, xp])
}

// ─────────────────────────────────────────────────────────────────────────
// MODERATION
// ─────────────────────────────────────────────────────────────────────────

enum ModerationAction {
  WARN
  MUTE
  TIMEOUT
  KICK
  BAN
  SOFTBAN
  TEMPBAN
  JAIL
  UNBAN
  UNMUTE
  LOCKDOWN
}

model ModerationCase {
  id            String            @id @default(cuid())
  caseNumber    Int
  guildId       String
  guild         Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  targetId      String
  targetTag     String
  moderatorId   String
  moderatorTag  String
  action        ModerationAction
  reason        String?           @db.Text
  duration      Int?              // seconds, for temp actions
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  expiresAt     DateTime?

  memberId      String?
  member        GuildMember?      @relation("MemberWarnings", fields: [memberId], references: [id])

  @@unique([guildId, caseNumber])
  @@map("moderation_cases")
  @@index([guildId, targetId])
}

model AutoModRule {
  id           String   @id @default(cuid())
  guildId      String
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name         String
  type         String   // spam, link, invite, mention, scam, phishing, token_grabber, word_filter
  enabled      Boolean  @default(true)
  config       Json     @default("{}")
  action       ModerationAction @default(WARN)
  createdAt    DateTime @default(now())

  @@map("automod_rules")
}

model ReactionRole {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  messageId String
  channelId String
  emoji     String
  roleId    String
  createdAt DateTime @default(now())

  @@map("reaction_roles")
}

model InviteRecord {
  id          String   @id @default(cuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  code        String
  inviterId   String
  uses        Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([guildId, code])
  @@map("invite_records")
}

model BoostEvent {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  type      String   // boost, unboost
  createdAt DateTime @default(now())

  @@map("boost_events")
}

// ─────────────────────────────────────────────────────────────────────────
// TICKETS / SUPPORT
// ─────────────────────────────────────────────────────────────────────────

enum TicketStatus {
  OPEN
  PENDING
  CLOSED
}

model Ticket {
  id           String       @id @default(cuid())
  ticketNumber Int
  guildId      String
  guild        Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId    String
  openerId     String
  openerTag    String
  subject      String
  status       TicketStatus @default(OPEN)
  category     String?
  assigneeId   String?
  assignee     User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdAt    DateTime     @default(now())
  closedAt     DateTime?
  closedReason String?      @db.Text

  messages     TicketMessage[]

  @@unique([guildId, ticketNumber])
  @@map("tickets")
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  authorTag  String
  content    String   @db.Text
  isAiReply  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("ticket_messages")
}

// ─────────────────────────────────────────────────────────────────────────
// ECONOMY
// ─────────────────────────────────────────────────────────────────────────

model EconomyProfile {
  id             String      @id @default(cuid())
  memberId       String      @unique
  member         GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  wallet         BigInt      @default(0)
  bank           BigInt      @default(0)
  bankCapacity   BigInt      @default(5000)
  lastDaily      DateTime?
  lastWeekly     DateTime?
  lastMonthly    DateTime?
  lastWork       DateTime?
  dailyStreak    Int         @default(0)
  job             String?

  inventory      InventoryItem[]
  transactions   Transaction[] @relation("TransactionOwner")
  pets           Pet[]

  @@map("economy_profiles")
}

model Item {
  id          String   @id @default(cuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  description String?
  emoji       String?
  price       BigInt
  type        String   // collectible, tool, boost, role, crate
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  inventoryEntries InventoryItem[]

  @@map("items")
}

model InventoryItem {
  id         String          @id @default(cuid())
  profileId  String
  profile    EconomyProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity   Int             @default(1)
  acquiredAt DateTime        @default(now())

  @@unique([profileId, itemId])
  @@map("inventory_items")
}

enum TransactionType {
  DAILY
  WEEKLY
  MONTHLY
  WORK
  TRANSFER
  PURCHASE
  SALE
  GAMBLE
  AUCTION
  FISHING
  MINING
  CRAFTING
  ADMIN_ADJUST
}

model Transaction {
  id          String          @id @default(cuid())
  profileId   String
  profile     EconomyProfile  @relation("TransactionOwner", fields: [profileId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      BigInt
  balanceAfter BigInt
  note        String?
  createdAt   DateTime        @default(now())

  @@map("transactions")
  @@index([profileId, createdAt])
}

model Pet {
  id         String         @id @default(cuid())
  profileId  String
  profile    EconomyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name       String
  species    String
  level      Int            @default(1)
  happiness  Int            @default(100)
  createdAt  DateTime       @default(now())

  @@map("pets")
}

// ─────────────────────────────────────────────────────────────────────────
// LEVELING
// ─────────────────────────────────────────────────────────────────────────

model LevelRoleReward {
  id      String @id @default(cuid())
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  level   Int
  roleId  String

  @@unique([guildId, level])
  @@map("level_role_rewards")
}

// ─────────────────────────────────────────────────────────────────────────
// ENGAGEMENT
// ─────────────────────────────────────────────────────────────────────────

model Giveaway {
  id         String   @id @default(cuid())
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId  String
  messageId  String?
  prize      String
  winnerCount Int     @default(1)
  hostId     String
  endsAt     DateTime
  endedAt    DateTime?
  entries    GiveawayEntry[]
  createdAt  DateTime @default(now())

  @@map("giveaways")
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  giveawayId String
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  userId     String
  enteredAt  DateTime @default(now())

  @@unique([giveawayId, userId])
  @@map("giveaway_entries")
}

model Reminder {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  channelId String
  content   String   @db.Text
  remindAt  DateTime
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("reminders")
}

model Birthday {
  id      String   @id @default(cuid())
  guildId String
  guild   Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId  String
  month   Int
  day     Int
  year    Int?

  @@unique([guildId, userId])
  @@map("birthdays")
}

// ─────────────────────────────────────────────────────────────────────────
// IDENTITY CARD SYSTEM (Roleplay — not an official ID)
// ─────────────────────────────────────────────────────────────────────────

enum IdentityCardType {
  MEMBER
  CITIZEN
  EMPLOYEE
  STUDENT
  VIP
  EVENT_PASS
  STAFF
  POLICE_RP
  MILITARY_RP
  ORGANIZATION
  CLAN
  GUILD
  COMPANY
  COMMUNITY
  CREATOR
  PREMIUM_MEMBER
}

model IdentityCard {
  id             String           @id @default(cuid())
  uniqueCode     String           @unique @default(cuid())
  guildId        String
  guild          Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?            @relation(fields: [userId], references: [id])
  discordUserId  String
  type           IdentityCardType
  fullName       String
  avatarUrl      String?
  backgroundUrl  String?
  theme          String           @default("default")
  badges         String[]         @default([])
  level          Int              @default(0)
  roleLabel      String?
  serverJoinDate DateTime?
  signature      String?
  qrCodeUrl      String?
  isVerified     Boolean          @default(false)
  shareSlug      String           @unique @default(cuid())
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("identity_cards")
  @@index([guildId, discordUserId])
}

// ─────────────────────────────────────────────────────────────────────────
// PREMIUM / BILLING
// ─────────────────────────────────────────────────────────────────────────

enum PremiumTier {
  FREE
  PREMIUM
  PREMIUM_PLUS
  ENTERPRISE
  LIFETIME
}

model Subscription {
  id             String      @id @default(cuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier           PremiumTier @default(FREE)
  guildId        String?
  status         String      @default("active") // active, canceled, expired, trialing
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  invoices       Invoice[]

  @@map("subscriptions")
}

model LicenseKey {
  id         String      @id @default(cuid())
  code       String      @unique
  tier       PremiumTier
  durationDays Int
  redeemedById String?
  redeemedAt DateTime?
  createdAt  DateTime    @default(now())
  expiresAt  DateTime?

  @@map("license_keys")
}

model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  discountPercent Int
  maxRedemptions  Int      @default(1)
  redemptions     Int      @default(0)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  @@map("coupons")
}

model Referral {
  id          String   @id @default(cuid())
  inviterId   String
  inviter     User     @relation("ReferralInviter", fields: [inviterId], references: [id])
  inviteeId   String   @unique
  invitee     User     @relation("ReferralInvitee", fields: [inviteeId], references: [id])
  rewardGranted Boolean @default(false)
  createdAt   DateTime @default(now())

  @@map("referrals")
}

model Invoice {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  amountCents    Int
  currency       String       @default("usd")
  status         String       @default("paid") // paid, pending, failed, refunded
  provider       String       @default("stripe")
  providerRef    String?
  createdAt      DateTime     @default(now())

  @@map("invoices")
}

// ─────────────────────────────────────────────────────────────────────────
// PLATFORM / ADMIN / ANALYTICS
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  guildId    String?
  guild      Guild?   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorTag   String?
  action     String
  target     String?
  metadata   Json     @default("{}")
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
  @@index([guildId, createdAt])
}

model Webhook {
  id          String   @id @default(cuid())
  guildId     String?
  guild       Guild?   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  url         String
  secret      String
  events      String[] @default([])
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("webhooks")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  type      String   @default("announcement") // announcement, news, changelog
  version   String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("announcements")
}

model GuildStatSnapshot {
  id            String   @id @default(cuid())
  guildId       String
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  memberCount   Int
  messageCount  Int
  commandCount  Int
  voiceMinutes  Int
  capturedAt    DateTime @default(now())

  @@map("guild_stat_snapshots")
  @@index([guildId, capturedAt])
}

model AiChatLog {
  id         String   @id @default(cuid())
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId     String
  channelId  String
  prompt     String   @db.Text
  response   String   @db.Text
  feature    String   @default("chat") // chat, image, translation, summarizer, moderation, ticket_reply, faq
  tokensUsed Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("ai_chat_logs")
}

model GuildPlugin {
  id         String   @id @default(cuid())
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  pluginKey  String
  enabled    Boolean  @default(true)
  config     Json     @default("{}")
  installedAt DateTime @default(now())

  @@unique([guildId, pluginKey])
  @@map("guild_plugins")
}

model Backup {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  data      Json
  reason    String   @default("manual")
  createdAt DateTime @default(now())

  @@map("backups")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  rolloutPercent Int @default(100)
  description String?
  updatedAt DateTime @updatedAt

  @@map("feature_flags")
}

model MaintenanceMode {
  id        Int      @id @default(1)
  enabled   Boolean  @default(false)
  message   String?
  updatedAt DateTime @updatedAt

  @@map("maintenance_mode")
}
