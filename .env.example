# ─────────────────────────────────────────────────────────────────────────
# NexusBot — environment configuration
# Copy to .env and fill in real values. Never commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────

# --- Shared / Infrastructure ---
NODE_ENV=development
DATABASE_URL=postgresql://nexusbot:nexusbot@localhost:5432/nexusbot?schema=public
REDIS_URL=redis://localhost:6379
POSTGRES_USER=nexusbot
POSTGRES_PASSWORD=nexusbot
POSTGRES_DB=nexusbot

# --- Discord Bot (apps/bot) ---
DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=your-discord-application-secret
DISCORD_DEV_GUILD_ID=
LOG_LEVEL=info

# --- AI Assistant (Claude) ---
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- REST API (apps/api) ---
PORT=4000
JWT_ACCESS_SECRET=change-me-32-char-minimum-secret
JWT_REFRESH_SECRET=change-me-different-32-char-secret
DISCORD_REDIRECT_URI=http://localhost:4000/api/v1/auth/discord/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# --- Dashboard (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.com/oauth2/authorize?client_id=your-discord-application-id&scope=bot%20applications.commands
