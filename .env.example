# ─────────────────────────────────────────────────────────────────────────
# Komunitas Bot — environment configuration
# Copy to .env and isi nilai asli. Jangan pernah commit file .env yang asli.
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# --- Discord ---
DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_DEV_GUILD_ID=
# Set "true" agar bot otomatis mendaftarkan slash command saat startup
# (untuk panel hosting tanpa akses terminal). Matikan lagi setelah command muncul.
AUTO_DEPLOY_COMMANDS=false
OWNER_IDS=

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/komunitas-bot

# --- Redis (cache, cooldown, rate limiter) ---
REDIS_URL=redis://localhost:6379

# --- AI (OpenRouter, kompatibel OpenAI SDK) ---
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://example.com
OPENROUTER_APP_NAME=KomunitasBot

# --- Digital KTP (identitas digital) ---
KTP_ISSUER_NAME=Dukcapil Komunitas
KTP_CARD_STORAGE_PATH=./storage/identity-cards
