{
  "name": "@nexusbot/agent",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight daemon that runs next to your own Discord bot and lets the NexusBot dashboard start/stop/restart it and stream its logs.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nexusbot/shared": "*",
    "socket.io-client": "^4.8.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
