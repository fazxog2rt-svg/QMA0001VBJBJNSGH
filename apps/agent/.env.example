# NexusBot Agent — runs next to YOUR bot process on YOUR server.
# Get NEXUS_AGENT_TOKEN by creating a Bot Instance in the dashboard
# (Dashboard -> Bot Console -> New Instance). The token is shown once.

# Base URL of the NexusBot API (no trailing slash, no /api/v1 suffix).
NEXUS_API_URL=http://localhost:4000

# Token issued by the dashboard when you created this instance.
NEXUS_AGENT_TOKEN=nxa_your-token-here

# The exact command used to start YOUR bot. Runs through the shell, so it can
# be anything: "node index.js", "npm start", "python bot.py", "./start.sh"...
# This is the ONLY command the agent will ever execute — the dashboard can
# send start/stop/restart signals but can never send it a different command.
NEXUS_START_COMMAND=npm start

# Directory to run the start command in. Defaults to the agent's own cwd.
NEXUS_WORKING_DIR=.

# Signal used to stop the process gracefully before force-killing. Default SIGTERM.
NEXUS_STOP_SIGNAL=SIGTERM

# Milliseconds to wait after the stop signal before force-killing (SIGKILL). Default 10000.
NEXUS_STOP_TIMEOUT_MS=10000

# If "true", automatically restart the process if it exits unexpectedly while
# it was supposed to be ONLINE (i.e. it crashed, not a user-requested stop).
NEXUS_RESTART_ON_CRASH=false

LOG_LEVEL=info
