# Base URL of the NexusBot REST API (apps/api), including the /api/v1 prefix
# is added per-call in lib/api.ts — point this at the server origin only.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Origin the Socket.IO realtime gateway (apps/api) listens on.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Public Discord "Add to server" invite/OAuth2 authorize link used by
# marketing CTAs and the servers picker "Invite bot" action.
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.com/oauth2/authorize?client_id=YOUR_CLIENT_ID&scope=bot%20applications.commands&permissions=8
