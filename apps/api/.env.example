# HTTP port the Express + Socket.IO server listens on
PORT=4000

# Postgres connection string, shared with @nexusbot/database
DATABASE_URL=postgresql://nexusbot:nexusbot@localhost:5432/nexusbot?schema=public

# Redis connection string — used for caching, rate limiting, the realtime
# event subscriber (nexus:events -> Socket.IO) and the bot-command publisher
# (nexus:bot-commands -> consumed by apps/bot).
REDIS_URL=redis://localhost:6379

# JWT secrets — MUST be long, random, and distinct per environment.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long

# Discord OAuth2 application credentials (Dashboard login + guild linking)
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-application-client-secret
DISCORD_REDIRECT_URI=http://localhost:4000/api/v1/auth/discord/callback

# Google OAuth2 application credentials (alternate login provider)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Comma-separated allowlist of origins permitted for CORS + cookies.
CORS_ORIGIN=http://localhost:3000

# Domain used when setting auth cookies (leave blank for host-only cookies in dev).
COOKIE_DOMAIN=

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

NODE_ENV=development
