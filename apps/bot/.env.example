# Discord application credentials
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-client-id
# Optional: when set, deploy-commands registers commands to this guild only (instant updates for dev).
# Omit / leave blank to register global commands (can take up to 1 hour to propagate).
DISCORD_DEV_GUILD_ID=

# Postgres connection string, shared with @nexusbot/database
DATABASE_URL=postgresql://nexusbot:nexusbot@localhost:5432/nexusbot?schema=public

# Redis connection string, used to publish realtime events consumed by apps/api
REDIS_URL=redis://localhost:6379

# Anthropic API key for the AI assistant features (ai-chat, ai-summarize, ai-translate, automod judgement).
# If omitted, AI commands reply with a helpful "not configured" message instead of failing.
ANTHROPIC_API_KEY=

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

NODE_ENV=development
