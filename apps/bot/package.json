{
  "name": "@nexusbot/bot",
  "version": "1.0.0",
  "private": true,
  "description": "NexusBot Discord bot — Discord.js v14 client with moderation, economy, leveling, tickets, identity cards, AI assistant, and plugin extensibility.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/handlers/deployCommands.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@napi-rs/canvas": "^0.1.53",
    "@nexusbot/database": "*",
    "@nexusbot/shared": "*",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "pino-pretty": "^11.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
